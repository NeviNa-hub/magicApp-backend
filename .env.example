APP_ENV=development
APP_LOG_LEVEL=INFO
# 我建的数据库名字为 magicapp_db
DATABASE_URL=postgresql+psycopg://magicapp:local_dev_password@127.0.0.1:5432/magicapp_db
DATABASE_CONNECT_TIMEOUT=3
SESSION_EXPIRE_DAYS=14
# 允许跨域的前端来源，逗号分隔；须与浏览器地址完全一致（协议、域名、端口，末尾无斜杠）。
CORS_ALLOW_ORIGINS=http://localhost:5173
# 仅本机 docker compose 启动 PostgreSQL 时需要，且应与 DATABASE_URL 中的密码一致。
POSTGRES_PASSWORD=local_dev_password

# 硅基流动 API Key，仅在本地或服务器环境中填写
SILICONFLOW_API_KEY=

# 图片上传持久目录；生产环境建议使用绝对路径并确保仅服务账号可读写
UPLOAD_DIR=uploads

# 硅基流动模型与生成配置；视频接口尚未实现，模型名称预留。
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_IMAGE_MODEL=Kwai-Kolors/Kolors
SILICONFLOW_IMAGE_EDIT_MODEL=Qwen/Qwen-Image-Edit-2509
SILICONFLOW_VIDEO_MODEL=MiniMaxAI/MiniMax-H3
SILICONFLOW_TIMEOUT_SECONDS=180
SILICONFLOW_IMAGE_SIZE_SQUARE=1024x1024
SILICONFLOW_IMAGE_SIZE_LANDSCAPE=1280x720
SILICONFLOW_IMAGE_SIZE_PORTRAIT=720x1280
SILICONFLOW_IMAGE_SIZE_CLASSIC=1024x768
