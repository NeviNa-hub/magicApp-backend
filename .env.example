APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8001
APP_LOG_LEVEL=INFO
# 我建的数据库名字为 magicapp_db
DATABASE_URL=postgresql+psycopg://magicapp:local_dev_password@127.0.0.1:5432/magicapp_db
DATABASE_CONNECT_TIMEOUT=3
SESSION_EXPIRE_DAYS=14
# 允许跨域的前端来源，逗号分隔；须与浏览器地址完全一致（协议、域名、端口，末尾无斜杠）。
CORS_ALLOW_ORIGINS=http://localhost:5173
# 仅本机 docker compose 启动 PostgreSQL 时需要，且应与 DATABASE_URL 中的密码一致。
POSTGRES_PASSWORD=local_dev_password
